      <Text style={{ fontSize: 28, color: '#3A4360', marginTop: 6 }}>中小餐饮经营 Agent</Text>
      <Box style={{ width: 88, height: 4, background: '#4C4DDC', borderRadius: 2, marginTop: 20, marginBottom: 20 }} />
      <Text style={{ fontSize: 20, color: '#5C6780', lineHeight: 1.75, width: 620 }}>
        不只告诉你哪里亏，还替你把账算平、把货备好、把菜单改对。
      </Text>
    </Box>

    <Box style={{ width: 360, background: '#EEF1FE', border: '1px solid #DDE2F5', borderRadius: 18, padding: 26, flexDirection: 'column', gap: 16 }}>
      <Text style={{ fontSize: 11, color: '#4C4DDC', fontWeight: 'bold', letterSpacing: 2 }}>DAILY LOOP</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 26, borderRadius: 8, background: '#4C4DDC', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>1</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#0C1222' }}>发现异常 · 3 件事</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 26, borderRadius: 8, background: '#4C4DDC', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>2</Text>
