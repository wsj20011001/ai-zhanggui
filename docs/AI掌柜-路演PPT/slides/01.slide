      <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#4C4DDC' }} />
      <Text style={{ fontSize: 12, color: '#4C4DDC', fontWeight: 'bold', letterSpacing: 1 }}>产业应用赛道</Text>
