<Slide style={{ width: 1280, height: 720, background: '#F6F8FD', padding: '56px 72px', flexDirection: 'column' }}>
  <Box style={{ height: 96, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
    <Box style={{ flexDirection: 'column', gap: 8 }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0C1222' }}>现场三分钟，只走一条路径</Text>
      <Text style={{ fontSize: 15, color: '#5C6780' }}>上午 09:00，老板打开电脑后的真实操作顺序</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6, padding: '5px 12px', background: '#EEF1FE', border: '1px solid #DDE2F5', borderRadius: 999 }}>
      <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#4C4DDC' }} />
      <Text style={{ fontSize: 12, color: '#4C4DDC', fontWeight: 'bold', letterSpacing: 1 }}>AI 掌柜</Text>
    </Box>
  </Box>
  <Box style={{ width: 72, height: 3, background: '#4C4DDC', borderRadius: 2, marginTop: 2, marginBottom: 12 }} />
  <Box style={{ flex: 1, paddingTop: 8 }}>
    <Box style={{ flexDirection: 'row', gap: 16, height: 205 }}>
      <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E3E8F5', borderRadius: 14, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 12, color: '#4C4DDC', letterSpacing: 2 }}>第 1 步 · 30 秒</Text>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0C1222', marginTop: 6 }}>打开驾驶舱</Text>
        <Text style={{ fontSize: 14, color: '#5C6780', lineHeight: 1.8 }}>只有 3 件事：<br />营收跌 20%、3 道菜滞销、<br />牛腩只够 1.5 天。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E3E8F5', borderRadius: 14, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 12, color: '#4C4DDC', letterSpacing: 2 }}>第 2 步 · 60 秒</Text>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0C1222', marginTop: 6 }}>点「营收下滑」</Text>
        <Text style={{ fontSize: 14, color: '#5C6780', lineHeight: 1.8 }}>拆成客流 −18%、客单价 −3%，<br />结论：人少了，<br />不是点便宜了。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E3E8F5', borderRadius: 14, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 12, color: '#4C4DDC', letterSpacing: 2 }}>第 3 步 · 60 秒</Text>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0C1222', marginTop: 6 }}>点「缺货」</Text>
        <Text style={{ fontSize: 14, color: '#5C6780', lineHeight: 1.8 }}>按 7 天用量生成采购单<br />→ 确认入库<br />→ 库存与流水同步。</Text>
      </Box>
    </Box>
    <Box style={{ marginTop: 20, background: '#EEF1FE', border: '1px solid #C9CDF6', borderRadius: 14, padding: '20px 24px', flexDirection: 'row', alignItems: 'center', gap: 24 }}>
      <Text style={{ fontSize: 13, color: '#4C4DDC', letterSpacing: 2, width: 132 }}>加演 · 一句话</Text>
      <Box style={{ flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0C1222' }}>「明天 8 人宴席，人均 150」</Text>
        <Text style={{ fontSize: 13, color: '#5C6780' }}>按中餐宴席结构排 10 道菜 → 一键成单 → 后厨立刻看到，可人工增减。</Text>
      </Box>
    </Box>
    <Box style={{ marginTop: 20, paddingTop: 16, borderTop: '1px solid #E3E8F5', flexDirection: 'row', gap: 0 }}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 3 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0C1222' }}>1 张</Text>
        <Text style={{ fontSize: 12, color: '#5C6780' }}>采购单（7 项 / 2,757 元）</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 3 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0C1222' }}>7 种</Text>
        <Text style={{ fontSize: 12, color: '#5C6780' }}>食材库存与流水同步更新</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 3 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0C1222' }}>3 条</Text>
        <Text style={{ fontSize: 12, color: '#5C6780' }}>操作留痕，任何一条可回滚</Text>
      </Box>
      <Box style={{ flex: 1.2, flexDirection: 'column', gap: 3 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#4C4DDC' }}>0 次</Text>
        <Text style={{ fontSize: 12, color: '#5C6780' }}>页面跳转 —— 决策与执行同屏</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 36, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
    <Text style={{ fontSize: 12, color: '#8A93A8' }}>2026 武汉 1024 · 产业应用赛道</Text>
    <Text style={{ fontSize: 12, color: '#8A93A8' }}>05 / 12</Text>
  </Box>
</Slide>