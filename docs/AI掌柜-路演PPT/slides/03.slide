<Slide style={{ width: 1280, height: 720, background: '#F6F8FD', padding: '56px 72px', flexDirection: 'column' }}>
  <Box style={{ height: 96, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
    <Box style={{ flexDirection: 'column', gap: 8 }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0C1222' }}>分水岭不在图表，在「能不能动手」</Text>
      <Text style={{ fontSize: 15, color: '#5C6780' }}>同样一份营收下滑，两条完全不同的处理路径</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6, padding: '5px 12px', background: '#EEF1FE', border: '1px solid #DDE2F5', borderRadius: 999 }}>
      <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#4C4DDC' }} />
      <Text style={{ fontSize: 12, color: '#4C4DDC', fontWeight: 'bold', letterSpacing: 1 }}>AI 掌柜</Text>
    </Box>
  </Box>
  <Box style={{ width: 72, height: 3, background: '#4C4DDC', borderRadius: 2, marginTop: 2, marginBottom: 12 }} />
  <Box style={{ flex: 1, paddingTop: 8 }}>
    <Box style={{ flexDirection: 'row', gap: 24, height: 330 }}>
      <Box style={{ flex: 1, background: '#FBFCFE', border: '1px solid #E3E8F5', borderRadius: 14, padding: 26 }}>
        <Text style={{ fontSize: 13, color: '#8A93A8', letterSpacing: 2 }}>传统 BI / 经营看板</Text>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#5C6780', marginTop: 10 }}>价值停在「知道」</Text>
        <Box style={{ marginTop: 22, flexDirection: 'column', gap: 14 }}>
          <Text style={{ fontSize: 16, color: '#5C6780' }}>看板 → 发现跌了</Text>
          <Text style={{ fontSize: 16, color: '#5C6780' }}>→ 自己判断原因</Text>
          <Text style={{ fontSize: 16, color: '#5C6780' }}>→ 自己打电话订货</Text>
          <Text style={{ fontSize: 16, color: '#5C6780' }}>→ 一周后忘了复盘</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, background: '#EEF1FE', border: '1px solid #C9CDF6', borderRadius: 14, padding: 26 }}>
        <Text style={{ fontSize: 13, color: '#4C4DDC', letterSpacing: 2 }}>AI 掌柜</Text>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0C1222', marginTop: 10 }}>价值走到「改变」</Text>
        <Box style={{ marginTop: 22, flexDirection: 'column', gap: 14 }}>
          <Text style={{ fontSize: 16, color: '#0C1222' }}>驾驶舱 → 3 件事 + 证据</Text>
          <Text style={{ fontSize: 16, color: '#0C1222' }}>→ 拆解成客流 / 客单价</Text>
          <Text style={{ fontSize: 16, color: '#0C1222' }}>→ 一键生成采购单并入库</Text>
          <Text style={{ fontSize: 16, color: '#0C1222' }}>→ 7 天后自动回填效果</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ marginTop: 28, background: '#EEF1FE', border: '1px solid #C9CDF6', borderRadius: 12, padding: '18px 24px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
      <Text style={{ fontSize: 11, color: '#4C4DDC', fontWeight: 'bold', letterSpacing: 2, width: 96 }}>同一条链路</Text>
      <Text style={{ fontSize: 15, color: '#0C1222' }}>发现异常</Text>
      <Text style={{ fontSize: 15, color: '#9AA3BE' }}>→</Text>
      <Text style={{ fontSize: 15, color: '#0C1222' }}>算清原因</Text>
      <Text style={{ fontSize: 15, color: '#9AA3BE' }}>→</Text>
      <Text style={{ fontSize: 15, color: '#0C1222' }}>动手执行</Text>
      <Text style={{ fontSize: 15, color: '#9AA3BE' }}>→</Text>
      <Text style={{ fontSize: 15, color: '#0C1222' }}>7 天后复核</Text>
      <Text style={{ fontSize: 12, color: '#5C6780', marginLeft: 8 }}>四步不换页面</Text>
    </Box>
    <Box style={{ marginTop: 22, flexDirection: 'row', gap: 14 }}>
      <Text style={{ fontSize: 15, color: '#5C6780' }}>三个关键词</Text>
      <Text style={{ fontSize: 15, color: '#4C4DDC', fontWeight: 'bold' }}>可执行 · 可追溯 · 可撤销</Text>
    </Box>
  </Box>
  <Box style={{ height: 36, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
    <Text style={{ fontSize: 12, color: '#8A93A8' }}>2026 武汉 1024 · 产业应用赛道</Text>
    <Text style={{ fontSize: 12, color: '#8A93A8' }}>03 / 12</Text>
  </Box>
</Slide>