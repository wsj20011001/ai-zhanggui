<Slide style={{ width: 1280, height: 720, background: '#F6F8FD', padding: '56px 72px', flexDirection: 'column' }}>
  <Box style={{ height: 96, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
    <Box style={{ flexDirection: 'column', gap: 8 }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0C1222' }}>附录 A · 界面实拍（无美化）</Text>
      <Text style={{ fontSize: 15, color: '#5C6780' }}>左边是老板每天看到的，右边是模型与数据的状态页</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6, padding: '5px 12px', background: '#EEF1FE', border: '1px solid #DDE2F5', borderRadius: 999 }}>
      <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#4C4DDC' }} />
      <Text style={{ fontSize: 12, color: '#4C4DDC', fontWeight: 'bold', letterSpacing: 1 }}>AI 掌柜</Text>
    </Box>
  </Box>
  <Box style={{ width: 72, height: 3, background: '#4C4DDC', borderRadius: 2, marginTop: 2, marginBottom: 12 }} />

  <Box style={{ flex: 1, flexDirection: 'row', gap: 22 }}>
    <Box style={{ flex: 1.62, background: '#FFFFFF', border: '1px solid #E3E8F5', borderRadius: 12, padding: 10, overflow: 'hidden' }}>
      <Image src="assets/ui_dashboard.png" style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'left top', borderRadius: 8 }} />
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E3E8F5', borderRadius: 12, padding: 8, height: 188, overflow: 'hidden' }}>
        <Image src="assets/ui_settings.png" style={{ width: '100%', height: '100%', objectFit: 'contain', borderRadius: 6 }} />
      </Box>
      <Text style={{ fontSize: 12, color: '#5C6780' }}>设置页实拍：本地 3B 已连接（2.0GB）＋ 云端 Key 可用</Text>

      <Box style={{ flexDirection: 'column', gap: 5, marginTop: 2 }}>
        <Text style={{ fontSize: 13, color: '#4C4DDC', letterSpacing: 1 }}>01 首屏只有三件事</Text>
        <Text style={{ fontSize: 13, color: '#5C6780', lineHeight: 1.6 }}>按影响金额排序，不是按模块罗列。</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 5 }}>
        <Text style={{ fontSize: 13, color: '#4C4DDC', letterSpacing: 1 }}>02 每条都带证据</Text>
        <Text style={{ fontSize: 13, color: '#5C6780', lineHeight: 1.6 }}>灰底那行是指标、当前值、基线、阈值。</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 5 }}>
        <Text style={{ fontSize: 13, color: '#4C4DDC', letterSpacing: 1 }}>03 按钮就是动作</Text>
        <Text style={{ fontSize: 13, color: '#5C6780', lineHeight: 1.6 }}>生成采购单、执行调价都是当场改数据。</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 36, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
    <Text style={{ fontSize: 12, color: '#8A93A8' }}>演示数据：180 天 / 6,808 单（seed_demo.py 生成）</Text>
    <Text style={{ fontSize: 12, color: '#8A93A8' }}>附录 A</Text>
  </Box>
</Slide>
